# Copy this file to .env.local and fill in real values, then run `npm run build`.
# See SETUP.md for full instructions.
#
# Note: NEXT_PUBLIC_ prefix means the value is bundled into the client-side
# JavaScript at build time. This is intentional — the Apps Script webhook URL
# is meant to be public-facing (it accepts submissions from "Anyone"), so
# baking it into the static export is the correct approach for shared hosting.

# Google Apps Script Web App deployment URL.
# Leave empty for local testing — submissions will be logged to the console.
NEXT_PUBLIC_SHEETS_WEBHOOK_URL=
